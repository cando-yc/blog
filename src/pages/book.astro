---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---
<Base title="預約" description="預約 30 分鐘免費初談。">
  <section class="read book">
    <header class="bh">
      <p class="muted mono">預約</p>
      <h1>30 分鐘免費初談</h1>
      <p class="lead">先聊聊你公司現在的財務狀況和卡住的點，我判斷適不適合、能怎麼接手。30 分鐘，不收費。</p>
    </header>

    <div class="how">
      <p>目前用 email 約時間。來信寫三件事就好：</p>
      <ul>
        <li>公司在做什麼、大概的規模</li>
        <li>現在財務由誰處理、哪裡卡住</li>
        <li>方便的時段</li>
      </ul>
      <a class="btn btn-accent" href={`mailto:${SITE.email}?subject=${encodeURIComponent('預約 30 分鐘初談')}`}>寫信預約</a>
    </div>

    <p class="alt muted">收到信後一個工作天內回覆。直接來信也可以：<a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
  </section>
</Base>

<style>
  .book { padding-top: 4rem; }
  .bh h1 { font-size: clamp(1.8rem, 5vw, 2.8rem); margin: .5rem 0 .8rem; }
  .lead { font-size: 1.05rem; }
  .how { border: 1px solid var(--line); padding: clamp(1.4rem, 3vw, 2rem); margin: 2.5rem 0 1.5rem; }
  .how p { margin: 0 0 .8rem; }
  .how ul { margin: 0 0 1.4rem; padding-left: 1.2rem; color: var(--ink-soft); }
  .how li { margin: .2rem 0; }
  .alt { font-size: .95rem; }
  .alt a { color: var(--accent); border-bottom: 1px solid var(--accent); }
</style>
