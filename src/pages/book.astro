---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---
<Base title="預約" description="預約 30 分鐘免費初談。">
  <section class="read book">
    <header class="bh">
      <p class="muted mono">預約</p>
      <h1>30 分鐘免費初談</h1>
      <p class="muted lead">〔待補：先聊聊你公司現在的財務狀況與痛點，判斷是否適合合作。〕</p>
    </header>

    <div class="embed" aria-hidden="true">
      <span class="muted">〔待接：Cal.com / 預約表單嵌入處〕</span>
    </div>

    <p class="alt muted">
      或來信：<a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </p>
  </section>
</Base>

<style>
  .book { padding-top: 4rem; }
  .bh h1 { font-size: clamp(1.8rem, 5vw, 2.8rem); margin: .5rem 0 .8rem; }
  .lead { font-size: 1.05rem; }
  .embed {
    border: 1px solid var(--line); min-height: 320px;
    display: flex; align-items: center; justify-content: center;
    margin: 2.5rem 0 1.5rem; font-size: .9rem;
  }
  .alt { font-size: .95rem; }
  .alt a { color: var(--accent); border-bottom: 1px solid var(--accent); }
</style>
