---
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../consts';
import { getCollection, render } from 'astro:content';
import AuthorCard from '../../components/AuthorCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('articles', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data.pubDate;
const dateStr = `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;

const all = (await getCollection('articles', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx < all.length - 1 ? all[idx + 1] : null;
const others = all.filter((p) => p.id !== post.id).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const related = [
  ...others.filter((p) => p.data.category === post.data.category),
  ...others.filter((p) => p.data.category !== post.data.category),
].slice(0, 3);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="read">
    <header class="post-head">
      <div class="meta muted mono">
        <time datetime={d.toISOString()}>{dateStr}</time>
        <span class="cat">{CATEGORIES[post.data.category] ?? post.data.category}</span>
      </div>
      <h1>{post.data.title}</h1>
    </header>
    {post.data.image && (
      <figure class="post-hero">
        <img src={post.data.image} alt={post.data.title} loading="eager" />
      </figure>
    )}
    <div class="prose">
      <Content />
    </div>
    <footer class="post-foot">
      {(prev || next) && (
        <nav class="pn">
          {prev ? (
            <a class="pn-item" href={`/articles/${prev.id}`}>
              <span class="pn-lbl muted">‹ 上一篇</span>
              <span class="pn-t">{prev.data.title}</span>
            </a>
          ) : <span class="pn-item" />}
          {next ? (
            <a class="pn-item pn-r" href={`/articles/${next.id}`}>
              <span class="pn-lbl muted">下一篇 ›</span>
              <span class="pn-t">{next.data.title}</span>
            </a>
          ) : <span class="pn-item" />}
        </nav>
      )}

      <AuthorCard />

      {related.length > 0 && (
        <section class="related">
          <h2>延伸閱讀</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={`/articles/${p.id}`}>
                  <span class="rel-cat mono muted">{CATEGORIES[p.data.category] ?? p.data.category}</span>
                  <span class="rel-t">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <a href="/articles" class="cta-text back">← 回文章列表</a>
    </footer>
  </article>
</Base>

<style>
  .post-head { padding: 4rem 0 2rem; border-bottom: 1px solid var(--line); }
  .meta { display: flex; gap: 1rem; font-size: .85rem; }
  .cat { color: var(--accent); }
  .post-head h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); margin: 1rem 0 .8rem; line-height: 1.25; }
  .byline { color: var(--ink-soft); margin: 0; font-size: .95rem; }
  .post-hero { margin: 2rem 0 0; }
  .post-hero img {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    display: block; border: 1px solid var(--line);
  }
  .prose { padding: 2.5rem 0; }
  .prose :global(h2) { font-size: 1.5rem; margin: 2.5rem 0 1rem; }
  .prose :global(h3) { font-size: 1.25rem; margin: 2rem 0 .8rem; }
  .prose :global(p) { margin: 0 0 1.4rem; }
  .prose :global(img) { margin: 2rem 0; border: 1px solid var(--line); }
  .prose :global(a) { color: var(--accent); border-bottom: 1px solid var(--accent); }
  .prose :global(blockquote) { border-left: 2px solid var(--accent); margin: 1.5rem 0; padding: .2rem 0 .2rem 1.2rem; color: var(--ink-soft); }
  .post-foot { border-top: 1px solid var(--line); padding: 2.5rem 0 0; }
  .pn { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 4vw, 3rem); margin-bottom: 2.8rem; }
  .pn-item { display: flex; flex-direction: column; gap: .35rem; }
  .pn-r { text-align: right; }
  .pn-lbl { font-size: .8rem; }
  .pn-t { font-size: .98rem; line-height: 1.4; }
  a.pn-item:hover .pn-t { color: var(--accent); }
  .related { margin: 2.8rem 0; }
  .related h2 { font-size: 1rem; letter-spacing: .04em; margin: 0 0 .8rem; padding-bottom: .5rem; border-bottom: 1px solid var(--ink); }
  .related ul { list-style: none; padding: 0; margin: 0; }
  .related li a { display: flex; gap: .9rem; align-items: baseline; padding: .85rem 0; border-top: 1px solid var(--line); }
  .related li:first-child a { border-top: none; }
  .related .rel-cat { font-size: .78rem; color: var(--accent); flex-shrink: 0; }
  .related .rel-t { font-size: 1rem; }
  .related li a:hover .rel-t { color: var(--accent); }
  .back { display: inline-block; margin-top: 1.5rem; }
  @media (max-width: 520px) {
    .pn { grid-template-columns: 1fr; }
    .pn-r { text-align: left; }
  }
</style>
