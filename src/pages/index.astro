import SiteBase from '../layouts/SiteBase.astro';
import HomePage from '../components/site/HomePage.svelte';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: '奕成財創',
  url: 'https://ycfinance.tw',
  email: 'contact@yicheng.finance',
  founder: {
    '@type': 'Person',
    name: '葉可為 Cando Yeh',
    jobTitle: '美國執業會計師（AICPA）',
  },
  description:
    '協助中小企業與新創把財務方針寫下來、落進帳與流程，透過每月固定月報與月會的財務治理，讓數字開始改變決定。',
