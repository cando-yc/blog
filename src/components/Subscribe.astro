---
// 電子報訂閱（Buttondown 公開內嵌端點；不需金鑰）
const ACTION = 'https://buttondown.com/api/emails/embed-subscribe/ycfinance';
---
<section class="subscribe">
  <span class="sub-prompt">想要收到電子報？</span>
  <form class="sub-form" action={ACTION} method="post" target="_blank">
    <input type="email" name="email" required placeholder="你的 Email" autocomplete="email" aria-label="你的 Email" />
    <input type="hidden" name="embed" value="1" />
    <button type="submit">訂閱</button>
  </form>
  <p class="sub-msg" role="status" aria-live="polite"></p>
</section>

<style>
  .subscribe {
    display: flex; align-items: center; flex-wrap: wrap; gap: .9rem 1.2rem;
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
    padding: 1.4rem 0;
  }
  .sub-prompt { font-family: var(--font-serif); font-size: 1.05rem; }
  .sub-form { display: flex; gap: .5rem; flex: 1; min-width: 240px; }
  .sub-form input[type="email"] {
    flex: 1; min-width: 0; padding: .6rem .85rem;
    border: 1px solid var(--line); background: var(--paper); color: var(--ink);
    font: inherit; font-size: .95rem;
  }
  .sub-form input[type="email"]:focus { outline: none; border-color: var(--accent); }
  .sub-form button {
    padding: .6rem 1.4rem; border: 1px solid var(--accent);
    background: var(--accent); color: #fff; font: inherit; font-size: .95rem;
    cursor: pointer; white-space: nowrap; transition: opacity .15s;
  }
  .sub-form button:hover { opacity: .88; }
  .sub-form button:disabled { opacity: .5; cursor: default; }
  .sub-msg { flex-basis: 100%; font-size: .9rem; margin: 0; color: var(--accent); }
  .sub-msg:empty { display: none; }
  .sub-done .sub-prompt, .sub-done .sub-form { display: none; }
  @media (max-width: 480px) {
    .sub-form { min-width: 100%; }
    .sub-form button { flex-shrink: 0; }
  }
</style>

<script>
  document.querySelectorAll('.subscribe').forEach((section) => {
    const form = section.querySelector('.sub-form') as HTMLFormElement | null;
    const msg = section.querySelector('.sub-msg') as HTMLElement | null;
    if (!form || !msg) return;
    const btn = form.querySelector('button') as HTMLButtonElement;
    const input = form.querySelector('input[type="email"]') as HTMLInputElement;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!input.reportValidity()) return;
      btn.disabled = true;
      const prev = btn.textContent;
      btn.textContent = '送出中…';
      try {
        await fetch(form.action, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams({ email: input.value.trim(), embed: '1' }),
        });
        section.classList.add('sub-done');
        msg.textContent = '收到了，請到信箱點一下確認信，就完成訂閱。';
        form.reset();
      } catch (err) {
        btn.disabled = false;
        btn.textContent = prev;
        msg.textContent = '送出失敗，請稍後再試。';
      }
    });
  });
</script>
