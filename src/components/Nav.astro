---
import { SITE, NAV } from '../consts';
interface Props { reveal?: boolean; }
const { reveal = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class:list={["topbar", { reveal }]} id="topbar">
  <div class="wrap tb-inner">
    <a href="/articles" class="brand">{SITE.blogName}</a>
    <nav aria-label="主導覽">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} class:list={[{ active: isActive(item.href) }]}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .topbar { background: var(--paper); border-bottom: 1px solid var(--line); z-index: 50; }
  .topbar:not(.reveal) { position: sticky; top: 0; }
  .topbar.reveal {
    position: fixed; top: 0; left: 0; right: 0;
    transform: translateY(-100%); transition: transform .25s ease;
  }
  .topbar.reveal.show { transform: translateY(0); }
  .tb-inner { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .brand { font-family: var(--font-serif); font-size: 1.1rem; font-weight: 500; letter-spacing: .04em; }
  nav ul { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; font-size: .95rem; color: var(--ink-soft); }
  nav a.active { color: var(--accent); }
  @media (max-width: 600px) { nav ul { gap: 1rem; font-size: .85rem; } }
</style>
