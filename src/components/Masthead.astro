---
import { SITE, NAV } from '../consts';
---
<header class="masthead">
  <div class="mh-top">
    <a href="/" class="mh-ico" aria-label="回奕成財創首頁">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/></svg>
      <span>官網</span>
    </a>
    <div class="mh-top-r">
      <a href={SITE.bookingUrl} class="mh-ico mh-ico--book" aria-label="預約諮詢">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><rect x="3.5" y="5" width="17" height="16" rx="2"/><line x1="3.5" y1="9.5" x2="20.5" y2="9.5"/><line x1="8" y1="2.6" x2="8" y2="6"/><line x1="16" y1="2.6" x2="16" y2="6"/></svg>
        <span>預約</span>
      </a>
      <a href={SITE.fb} class="mh-ico" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.5-3.91 3.79-3.91 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.9h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
      </a>
    </div>
  </div>
  <a href="/articles" class="mh-brand" aria-label={SITE.blogName}>
    <img src="/yclogo.svg" alt={SITE.blogName} class="mh-logo" width="128" height="110" />
    <span class="mh-word">{SITE.blogName}</span>
    <span class="mh-sub">{SITE.titleTagline}</span>
  </a>
  <nav class="mh-nav" aria-label="主導覽">
    <ul>
      {NAV.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .masthead {
    position: relative;
    text-align: center;
    padding: clamp(3.6rem, 7vw, 5.6rem) 1rem clamp(1.1rem, 2.4vw, 1.7rem);
    will-change: opacity;
  }
  /* 底線對齊置中內容欄，不拉滿版 */
  .masthead::after {
    content: '';
    position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
    width: min(var(--wrap), calc(100% - 2 * var(--step)));
    border-bottom: 1px solid var(--line);
  }
  .mh-top {
    position: absolute;
    top: clamp(1rem, 2.6vw, 1.7rem);
    left: 50%; transform: translateX(-50%);
    width: min(var(--wrap), calc(100% - 2 * var(--step)));
    display: flex; align-items: center; justify-content: space-between;
  }
  .mh-top-r { display: flex; align-items: center; gap: clamp(.9rem, 2.2vw, 1.5rem); }
  .mh-ico {
    display: inline-flex; align-items: center; gap: .35rem;
    color: var(--ink-mute); font-size: .9rem; letter-spacing: .06em;
    transition: color .15s ease;
  }
  .mh-ico:hover { color: var(--accent); }
  .mh-ico svg { display: block; }
  @media (max-width: 600px) {
    .mh-ico--book span { display: none; }
  }
  .mh-brand { display: inline-block; }
  .mh-logo {
    display: block; margin: 0 auto;
    height: clamp(50px, 7vw, 72px); width: auto;
  }
  .mh-word {
    display: block; font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.6vw, 2.1rem); font-weight: 500;
    letter-spacing: .18em; margin: .35rem 0 0; padding-left: .18em;
  }
  .mh-sub {
    display: block; color: var(--ink-mute);
    font-size: .82rem; letter-spacing: .14em; margin-top: .4rem;
  }
  .mh-nav ul {
    display: flex; justify-content: center; flex-wrap: wrap;
    gap: clamp(1.4rem, 5vw, 3.6rem); list-style: none; padding: 0;
    margin: 1.6rem 0 0; font-size: 1.02rem; color: var(--ink-soft);
  }
  .mh-nav a:hover { color: var(--accent); }
  @media (max-width: 600px) { .mh-nav ul { gap: 1.2rem; font-size: .95rem; } }
</style>

<script>
  const bar = document.getElementById('topbar');
  const mh = document.querySelector('.masthead') as HTMLElement | null;
  if (bar && bar.classList.contains('reveal') && mh) {
    const onScroll = () => {
      const y = window.scrollY;
      const h = mh.offsetHeight || 1;
      const start = h / 3;
      // 1/3 前完全清晰；過 1/3 隨捲動淡出，捲離頂端剛好淡完（無白空白）
      mh.style.opacity = String(y <= start ? 1 : Math.max(0, 1 - (y - start) / (h - start)));
      // 導覽列在 1/3 處浮出
      bar.classList.toggle('show', y > start);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    onScroll();
  }
</script>
