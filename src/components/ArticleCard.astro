---
import { CATEGORIES } from '../consts';
interface Props {
  href: string;
  title: string;
  description?: string;
  pubDate: Date;
  category: string;
  image?: string;
}
const { href, title, description, pubDate, category, image } = Astro.props;
const d = pubDate;
const dateStr = `${d.getFullYear()}/${d.getMonth() + 1}/${d.getDate()}`;
---
<a href={href} class="card">
  <div class="card-text">
    <div class="meta">
      <time class="mono muted" datetime={d.toISOString()}>{dateStr}</time>
      <span class="cat">{CATEGORIES[category] ?? category}</span>
    </div>
    <h3 class="title">{title}</h3>
    {description && <p class="desc muted">{description}</p>}
  </div>
  {image && (
    <div class="thumb">
      <img src={image} alt={title} loading="lazy" width="200" height="112" />
    </div>
  )}
</a>

<style>
  .card {
    display: flex; gap: clamp(1rem, 3vw, 2rem); align-items: flex-start;
    padding: 1.6rem 0; border-top: 1px solid var(--line);
  }
  .card:hover .title { color: var(--accent); }
  .card-text { flex: 1; min-width: 0; }
  .meta { display: flex; gap: 1rem; align-items: baseline; font-size: .82rem; margin-bottom: .5rem; }
  .cat { color: var(--accent); letter-spacing: .04em; }
  .title { font-size: 1.35rem; margin: 0; }
  .desc { font-size: .95rem; margin: .5rem 0 0; }
  .thumb { flex-shrink: 0; width: clamp(120px, 22vw, 200px); }
  .thumb img {
    width: 100%; aspect-ratio: 16 / 9; object-fit: cover;
    display: block; border: 1px solid var(--line);
  }
  @media (max-width: 460px) {
    .thumb { display: none; }
  }
</style>
